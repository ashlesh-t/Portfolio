MONGODB_URI=mongodb://localhost:27017/portfolio

# Required for /adminmode and any write to /api/* resource routes.
# The app fails closed (denies all admin/write access) if these are unset —
# do not use guessable defaults like admin/admin123.
ADMIN_USERNAME=
ADMIN_PASSWORD=

GITHUB_USERNAME=yourusername
GITHUB_TOKEN=your_personal_access_token_here

# Gmail account used to send/receive contact-form notification emails.
# GMAIL_APP_PASSWORD must be a Google App Password (Google Account ->
# Security -> 2-Step Verification -> App passwords), not your normal password.
GMAIL_USER=sollutionscode@gmail.com
GMAIL_APP_PASSWORD=
